<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes Startup Selector as one self-contained StartupSelector.exe (no .NET install needed).
     Visual Studio: right-click the project > Publish > select this profile.
     CLI:           dotnet publish src/StartupSelector -p:PublishProfile=SingleFile-win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
