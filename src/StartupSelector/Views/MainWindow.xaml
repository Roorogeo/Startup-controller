<Window x:Class="StartupSelector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StartupSelector.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Startup Selector"
        Style="{StaticResource DarkWindowStyle}"
        Icon="/Resources/app.ico"
        Width="940"
        Height="660"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="OnUserActivity"
        PreviewKeyDown="OnUserActivity"
        Closing="OnClosing">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ================================================= startup row -->
        <DataTemplate x:Key="StartupRowTemplate" DataType="{x:Type vm:StartupItemViewModel}">
            <Border x:Name="Row"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsChecked}"
                              IsEnabled="{Binding IsManaged}"
                              VerticalAlignment="Center"
                              ToolTip="{Binding CheckBoxToolTip}"
                              ToolTipService.ShowOnDisabled="True"
                              AutomationProperties.Name="{Binding DisplayName}" />

                    <Image Grid.Column="1"
                           Source="{Binding Icon}"
                           Width="28"
                           Height="28"
                           Margin="12,0,12,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentBrush}"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="6,0,2,0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Added to Windows startup since the last time you looked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="NEW" Foreground="{StaticResource OnAccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource OnAccentBrush}"
                                                Padding="4,1"
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="8"
                                                Content="&#xE711;"
                                                ToolTip="Mark as seen"
                                                Command="{Binding DataContext.DismissNewCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                                <Image Source="{Binding ShieldIcon}"
                                       Width="16"
                                       Height="16"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowShield, Converter={StaticResource BoolToVisibility}}"
                                       ToolTip="Belongs to all users: changing it asks for administrator approval" />
                                <Control Template="{StaticResource WarningGlyph}"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="{Binding ProblemText}" />
                            </StackPanel>
                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                                <Run Text="{Binding Description, Mode=OneWay, StringFormat='  {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding DisplayPath}"
                                   Style="{StaticResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"
                                   ToolTip="{Binding Details}" />
                        <TextBlock Text="{Binding ProblemText}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0"
                                   ToolTip="{Binding ProblemText}"
                                   Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Width="190" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource SecondaryText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" TextAlignment="Right" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="4"
                            MinWidth="96"
                            VerticalAlignment="Center"
                            ToolTip="{Binding ManageButtonToolTip}"
                            Command="{Binding DataContext.ToggleManageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding ShieldIcon}"
                                   Width="14"
                                   Height="14"
                                   Margin="0,0,6,0"
                                   Visibility="{Binding ShowShield, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding ManageButtonText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentSubtleBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsManaged}" Value="True">
                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabledInWindowsWhileManaged}" Value="True">
                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Resources/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Startup Selector" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Choose which apps start this session." Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="modified"
                           FontStyle="Italic"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           ToolTip="The checkboxes differ from the selected preset. Use ⋯ > Update to save them."
                           Visibility="{Binding IsSelectionModified, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="Preset" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="210"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          Tag="Choose a preset…"
                          ToolTip="Load a saved selection (★ = launched automatically at sign-in)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PresetViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,6,0"
                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Save as…"
                        Margin="8,0,0,0"
                        Command="{Binding SavePresetAsCommand}"
                        ToolTip="Save the current checkboxes as a new preset" />
                <Button x:Name="PresetMenuButton"
                        Margin="6,0,0,0"
                        Padding="10,6"
                        FontFamily="{StaticResource IconFont}"
                        Content="&#xE712;"
                        ToolTip="More preset actions"
                        Click="OnPresetMenuClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Update selected preset with current checkboxes" Command="{Binding UpdatePresetCommand}" />
                            <MenuItem Header="Rename…" Command="{Binding RenamePresetCommand}" />
                            <MenuItem Header="Set as default (auto-launch at sign-in)" Command="{Binding SetDefaultPresetCommand}" />
                            <Separator />
                            <MenuItem Header="Delete preset" Command="{Binding DeletePresetCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================= countdown -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="{StaticResource RadiusLg}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderHoverBrush}"
                BorderThickness="1"
                Visibility="{Binding IsCountdownVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CountdownText}" />
                    <ProgressBar Value="{Binding CountdownProgress, Mode=OneWay}" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="PauseButton" Content="{Binding CountdownPauseButtonText}" Command="{Binding ToggleCountdownPauseCommand}" MinWidth="84" Margin="0,0,8,0" />
                    <Button Content="Launch now" Command="{Binding LaunchSelectedCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= info bars -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding InfoBars}" Margin="0,12,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InfoBarViewModel}">
                    <Border x:Name="Bar"
                            Margin="0,0,0,6"
                            Padding="14,8,6,8"
                            CornerRadius="{StaticResource RadiusLg}"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Control x:Name="Glyph"
                                     Template="{StaticResource WarningGlyph}"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Margin="12,0,0,0"
                                    Content="{Binding ActionText}"
                                    Command="{Binding ActionCommand}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Column="3"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource IconButton}"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="10"
                                    Padding="8,6"
                                    Content="&#xE711;"
                                    ToolTip="Dismiss"
                                    Command="{Binding DismissCommand}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource WarningSubtleBrush}" />
                            <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ================================================= toolbar -->
        <Grid Grid.Row="3" Margin="0,6,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="All On" Command="{Binding AllOnCommand}" MinWidth="80" ToolTip="Check every managed app" />
                <Button Content="All Off" Command="{Binding AllOffCommand}" MinWidth="80" Margin="8,0,0,0" ToolTip="Uncheck every managed app" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Manage all…" Command="{Binding ManageAllCommand}" ToolTip="Take control of every app still controlled by Windows" />
                <Button Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Scan startup locations again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}" ToolTip="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================= list -->
        <Grid Grid.Row="4">
            <ListBox ItemsSource="{Binding ItemsView}"
                     ItemTemplate="{StaticResource StartupRowTemplate}"
                     ItemContainerStyle="{StaticResource StartupRowContainer}"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     Focusable="False">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="2,10,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='({0})'}" />
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}"
                       FontSize="15"
                       Text="No startup apps were found."
                       Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <!-- ================================================= footer -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" />
                <TextBlock Text="{Binding AdminHint}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Hide to tray" Click="OnHideClick" Margin="0,0,8,0" ToolTip="Keep Startup Selector running in the notification area" />
                <Button Content="{Binding LaunchButtonText}"
                        Command="{Binding LaunchSelectedCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="170"
                        ToolTip="Start the checked apps now, then minimize to the tray" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
