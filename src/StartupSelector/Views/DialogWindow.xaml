<Window x:Class="StartupSelector.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindowStyle}"
        Icon="/Resources/app.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Control x:Name="WarningIcon"
                 Template="{StaticResource WarningGlyph}"
                 VerticalAlignment="Top"
                 Margin="0,2,12,0"
                 Visibility="Collapsed" />
        <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" LineHeight="19" />

        <TextBox x:Name="InputBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,12,0,0"
                 MaxLength="80"
                 Visibility="Collapsed"
                 TextChanged="OnInputChanged" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Grid.Column="1"
                   Margin="0,6,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button x:Name="OkButton" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
