<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the NotifyIcon (system tray icon) and its menu. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Disabled so WPF and WinForms types (Application, MessageBox, ...) never collide. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StartupSelector</AssemblyName>
    <RootNamespace>StartupSelector</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Startup Selector</Product>
    <AssemblyTitle>Startup Selector</AssemblyTitle>
    <Description>Choose which startup apps to launch every time you sign in to Windows.</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets the project also compile on non-Windows build agents (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WFAC010 is a WinForms-app analyzer; for a WPF app the manifest is the right place for per-monitor DPI. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <!-- Inter (SIL Open Font License, see Fonts\Inter-OFL.txt), used by the Noir theme. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
